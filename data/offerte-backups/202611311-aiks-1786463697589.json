    "defaultTemplatePriceLineGroup": {
      "type": "priceLineGroup",
      "data": {
        "lines": [
          {
            "units": 1,
            "description": "**Suneye voorraad scherm**\nType: knikarmscherm bedraad\nBreedte: 5000 mm\nUitval: 3000 mm\nFrame kleur: RAL 7016 structuur (standaard)\nKleur doek: Beige\nBediening: afstandsbediening\nMotor: somfy RS100 IO\nMotorzijde: NTB\nKleur/lengte motorkabel: NTB\nOverige: NTB\nCassette: Gesloten, slank design\n\n**Waarom dit knikarmscherm**\nPremium knikarmscherm met gesloten cassette. Doek en mechaniek volledig beschermd. Direct leverbaar uit voorraad: snellere levertijd dan maatwerk. Sterke aluminium armen: lang meegaand en stabiel. Fluisterstille Somfy motor met afstandsbediening.\nGarantie: 5 jaar op het product, 7 jaar op de motor.",
            "pricePerUnit": 3175,
            "vatPercentage": 21,
            "position": 0,
            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Demonteren en afvoeren oud scherm/rolluik**\nPer product, waarvan €25 gedoneerd aan het Prinses Máxima Kinderziekenhuis.",
            "pricePerUnit": 75,
            "vatPercentage": 21,
            "position": 1,
            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Inmeten + montage Knikarmscherm uitgebreid.**\n- Inclusief uitbouw\n- Montage d.m.v. chemisch anker\n- Afwerken elektra\n- Klein materiaal\n- Afstellen zonwering\n- Verwerken verpakkingsmateriaal",
            "pricePerUnit": 325,
            "vatPercentage": 21,
            "position": 2,
            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Tahoma Switch**\n- Automatiseren van je Somfy producten\n- Producten bedienen waar je ook bent met de telefoon\n- Inclusief installatie en uitleg\n- Al uw smart home producten op 1 app (zoals Philips Hue)",
            "pricePerUnit": 195,
            "vatPercentage": 21,
            "position": 3,
            "lockTotalPrice": false
          }
        ],
