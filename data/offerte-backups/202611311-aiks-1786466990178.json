    "defaultTemplatePriceLineGroup": {
      "type": "priceLineGroup",
      "data": {
        "lines": [
          {
            "units": 1,
            "description": "**Demonteren en afvoeren oud scherm/rolluik**\nPer product, waarvan €25 gedoneerd aan het Prinses Máxima Kinderziekenhuis.",
            "pricePerUnit": 75,
            "vatPercentage": 21,
            "position": 0,
            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Suneye knikarmscherm**\nBreedte: 4350 mm\nUitval: 3000 mm\nBediening: afstandsbediening\nMotor: somfy RS100 IO\nCassette: Gesloten, slank design\nKleur doek: n.t.b. (alle doekstalen bekijk je bij het inmeten)\nFrame Kleur: RAL 7016 structuur (standaard)\nGarantie: 3 jaar montage | 5 jaar product | 7 jaar motor\n\n**Liever een ander model of bediening?**\n\nAnder model:\n• SunBasic (open arm, geen cassette): -€710\n• SunBasic Cassette (gesloten, instap): -€446\n• SunEye XL (extra breed, tot 745cm): +€841\n• SunElite (topmodel, LED mogelijk): +€1042\n\nAndere bediening:\n• Draaistang (handmatig, geen motor): -€451\n• Orea WT (bedraad, wandschakelaar): -€152\n\nKleur:\n• Trendkleur: +€353\n• RAL kleur naar keuze: +€503\n\nLaat het ons weten, we passen het graag voor je aan.",
            "pricePerUnit": 3772,
            "vatPercentage": 21,
            "position": 1,
            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Inmeten + montage Knikarmscherm**\n- Inmeetafspraak bij je thuis\n- Professionele montage door ons eigen montageteam\n- Klein materiaal en bevestiging\n- Verwerken verpakkingsmateriaal",
            "pricePerUnit": 275,
            "vatPercentage": 21,
            "position": 2,
            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Tahoma Switch**\n- Automatiseren van je Somfy producten\n- Producten bedienen waar je ook bent met de telefoon\n- Inclusief installatie en uitleg\n- Al uw smart home producten op 1 app (zoals Philips Hue)",
            "pricePerUnit": 195,
            "vatPercentage": 21,
            "position": 3,
            "lockTotalPrice": false
          }
        ],
