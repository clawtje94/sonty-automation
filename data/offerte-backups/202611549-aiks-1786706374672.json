            "lockTotalPrice": false
          },
          {
            "units": 1,
            "description": "**Inmeten + montage Pergola**\n- Montage\n- Klein materiaal\n- Afstellen\n- Elektra afwerken\n- Verwerken verpakkingsmateriaal",
            "pricePerUnit": 650,
            "vatPercentage": 21,
            "lockTotalPrice": false
